---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { CASE_STUDIES, COMPANY } from '../config';
---
<Base title={`Case studies: ${COMPANY}`} description={`Six recruitment firms, the bottleneck each brought to ${COMPANY}, what was automated and the numbers before and after.`} noindex>
  <section class="band top">
    <div class="wrap">
      <h1>What changed on real desks.</h1>
      <p class="lede">Six recruitment firms, the bottleneck each one brought us, what we automated and the numbers before and after.</p>
    </div>
  </section>
  <section class="sec">
    <div class="wrap">
      <ul class="grid">
        {CASE_STUDIES.map((c) => {
          const r = c.results[0];
          return (
            <li>
              <a class="card ink item" href={`/case-studies/${c.slug}`}>
                <p class="who"><Logo name={c.client} />{c.client}</p>
                <h2>{c.title}</h2>
                <div class="stat">
                  <p class="move"><span class="was"><span class="sr">From </span>{r.before}</span><svg class="arr" aria-hidden="true"><use href="#i-arrow" /></svg><b><span class="sr">to </span>{r.after}</b></p>
                  <p class="lbl">{r.label}</p>
                </div>
                <span class="view"><span class="u">Read the case study</span> <svg class="arr"><use href="#i-arrow" /></svg></span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</Base>

<style>
  .top{padding-block:96px 88px}
  .top .wrap{container-type:inline-size;display:grid;gap:22px;justify-items:start}
  h1{color:#fff;max-width:900px;font-size:clamp(34px,8cqi,60px);line-height:1.05;letter-spacing:-.035em}
  .grid li{display:grid}
  .item{height:100%;grid-template-rows:auto 1fr auto auto;gap:12px;transition:border-color .3s ease}
  .who{display:flex;align-items:center;gap:.6em;font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--dim)}
  h2{color:#fff;font-size:22px;line-height:1.2;letter-spacing:-.02em;margin-top:6px}
  .stat{display:grid;gap:4px;margin-top:10px;padding-top:18px;border-top:1px solid rgba(255,255,255,.12)}
  .move{display:flex;align-items:center;gap:12px;font-variant-numeric:tabular-nums}
  .was{font-size:18px;font-weight:700;color:var(--dim);text-decoration:line-through;text-decoration-thickness:1px}
  .move .arr{width:16px;height:16px;color:var(--dim)}
  .move b{font-size:34px;line-height:1.1;font-weight:800;letter-spacing:-.03em;color:var(--ac)}
  .lbl{font-size:14px}
  .view{display:inline-flex;align-items:center;gap:6px;margin-top:10px;font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#fff}
  .view .arr{width:12px;height:12px}
  .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  /* the card outline turns accent, the label underlines and the arrow runs through */
  .view .u{position:relative}
  .view .u::after{content:"";position:absolute;left:0;right:0;bottom:-4px;height:2px;background:var(--ac);transform:scaleX(0);transform-origin:left;transition:transform .4s cubic-bezier(.2,.7,.2,1);will-change:transform}
  .item:focus-visible{outline:2px solid var(--ac);outline-offset:3px}
  .item:focus-visible .u::after{transform:scaleX(1)}
  @media (hover:hover){
    .item:hover{border-color:var(--ac)}
    .item:hover .u::after{transform:scaleX(1)}
    .item:hover .view .arr{animation:arr-fade-through .5s cubic-bezier(.5,0,.2,1)}
  }
  @media (max-width:900px){.top{padding-block:72px 64px}}
</style>
