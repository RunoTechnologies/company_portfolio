---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marks from '../components/Marks.astro';
import Why from '../components/Why.astro';
import BuildGrid from '../components/BuildGrid.astro';
import Steps from '../components/Steps.astro';
import Feedback from '../components/Feedback.astro';
import BookingBand from '../components/BookingBand.astro';
import { CLIENTS, COMPANY } from '../config';
import { services } from '../schema';
---
<Base title={`${COMPANY}: automation for staffing and recruiting firms`} description={`${COMPANY} builds sourcing, screening, follow-up and back-office automation for staffing and recruiting firms, so consultants place instead of chase.`} schema={services(Astro.site!)}>
  <div class="intro">
    <Hero />
    <Marks label="Past clients" items={CLIENTS} />
  </div>
  <Why />
  <BuildGrid />
  <Steps />
  <Feedback />
  <BookingBand />
</Base>

<style>
  /* hero and client strip fill the first screen below the 69px nav, so the white section after them starts below the fold */
  .intro{display:flex;flex-direction:column;min-height:calc(100svh - 69px)}
</style>
