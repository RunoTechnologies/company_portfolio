---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marks from '../components/Marks.astro';
import Why from '../components/Why.astro';
import BuildGrid from '../components/BuildGrid.astro';
import Steps from '../components/Steps.astro';
import Results from '../components/Results.astro';
import CtaBand from '../components/CtaBand.astro';
import Feedback from '../components/Feedback.astro';
import Engage from '../components/Engage.astro';
import BookingBand from '../components/BookingBand.astro';
import { COMPANY } from '../config';
---
<Base title={`${COMPANY}: automation for staffing and recruiting firms`}>
  <Hero />
  <Marks
    label="Built for the desks that run on volume"
    items={['Light industrial', 'Healthcare', 'Logistics', 'Hospitality', 'Admin and clerical', 'Executive search']}
  />
  <Why />
  <Marks stack label="The stack we build on" items={['Anthropic', 'OpenAI', 'Twilio', 'Postgres', 'n8n', 'Cal.com']} />
  <BuildGrid />
  <Steps />
  <Results />
  <CtaBand />
  <Feedback />
  <Engage />
  <BookingBand />
</Base>
