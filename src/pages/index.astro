---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marks from '../components/Marks.astro';
import Why from '../components/Why.astro';
import BuildGrid from '../components/BuildGrid.astro';
import Steps from '../components/Steps.astro';
import Results from '../components/Results.astro';
import Feedback from '../components/Feedback.astro';
import BookingBand from '../components/BookingBand.astro';
import { CLIENTS, COMPANY } from '../config';
---
<Base title={`${COMPANY}: automation for staffing and recruiting firms`}>
  <Hero />
  <Marks label="Past clients" items={CLIENTS} />
  <Why />
  <BuildGrid />
  <Steps />
  <Results />
  <Feedback />
  <BookingBand />
</Base>
