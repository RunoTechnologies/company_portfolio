---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BookingBand from '../components/BookingBand.astro';
import { COMPANY, EMAIL, FOUNDER } from '../config';

// Issuer marks for the cert cards (Simple Icons paths; Microsoft's squares in its four brand colours).
// Each box crops its mark's drawn area, so the marks share one height whatever their shape.
const LOGOS: Record<string, { label: string; box: string; svg: string }> = {
  anthropic: { label: 'Anthropic', box: '0 3.54 24 16.92', svg: '<path fill="#191919" d="M17.3041 3.541h-3.6718l6.696 16.918H24Zm-10.6082 0L0 20.459h3.7442l1.3693-3.5527h7.0052l1.3693 3.5528h3.7442L10.5363 3.5409Zm-.3712 10.2232 2.2914-5.9456 2.2914 5.9456Z"/>' },
  microsoft: { label: 'Microsoft', box: '0 0 24 24', svg: '<path fill="#f25022" d="M0 0h11.4v11.4H0z"/><path fill="#7fba00" d="M12.6 0H24v11.4H12.6z"/><path fill="#00a4ef" d="M0 12.6h11.4V24H0z"/><path fill="#ffb900" d="M12.6 12.6H24V24H12.6z"/>' },
  aws: { label: 'Amazon Web Services', box: '0 4.82 24 14.35', svg: '<path fill="#232f3e" d="M6.763 10.036c0 .296.032.535.088.71.064.176.144.368.256.576.04.063.056.127.056.183 0 .08-.048.16-.152.24l-.503.335a.383.383 0 0 1-.208.072c-.08 0-.16-.04-.239-.112a2.47 2.47 0 0 1-.287-.375 6.18 6.18 0 0 1-.248-.471c-.622.734-1.405 1.101-2.347 1.101-.67 0-1.205-.191-1.596-.574-.391-.384-.59-.894-.59-1.533 0-.678.239-1.23.726-1.644.487-.415 1.133-.623 1.955-.623.272 0 .551.024.846.064.296.04.6.104.918.176v-.583c0-.607-.127-1.03-.375-1.277-.255-.248-.686-.367-1.3-.367-.28 0-.568.031-.863.103-.295.072-.583.16-.862.272a2.287 2.287 0 0 1-.28.104.488.488 0 0 1-.127.023c-.112 0-.168-.08-.168-.247v-.391c0-.128.016-.224.056-.28a.597.597 0 0 1 .224-.167c.279-.144.614-.264 1.005-.36a4.84 4.84 0 0 1 1.246-.151c.95 0 1.644.216 2.091.647.439.43.662 1.085.662 1.963v2.586zm-3.24 1.214c.263 0 .534-.048.822-.144.287-.096.543-.271.758-.51.128-.152.224-.32.272-.512.047-.191.08-.423.08-.694v-.335a6.66 6.66 0 0 0-.735-.136 6.02 6.02 0 0 0-.75-.048c-.535 0-.926.104-1.19.32-.263.215-.39.518-.39.917 0 .375.095.655.295.846.191.2.47.296.838.296zm6.41.862c-.144 0-.24-.024-.304-.08-.064-.048-.12-.16-.168-.311L7.586 5.55a1.398 1.398 0 0 1-.072-.32c0-.128.064-.2.191-.2h.783c.151 0 .255.025.31.08.065.048.113.16.16.312l1.342 5.284 1.245-5.284c.04-.16.088-.264.151-.312a.549.549 0 0 1 .32-.08h.638c.152 0 .256.025.32.08.063.048.12.16.151.312l1.261 5.348 1.381-5.348c.048-.16.104-.264.16-.312a.52.52 0 0 1 .311-.08h.743c.127 0 .2.065.2.2 0 .04-.009.08-.017.128a1.137 1.137 0 0 1-.056.2l-1.923 6.17c-.048.16-.104.263-.168.311a.51.51 0 0 1-.303.08h-.687c-.151 0-.255-.024-.32-.08-.063-.056-.119-.16-.15-.32l-1.238-5.148-1.23 5.14c-.04.16-.087.264-.15.32-.065.056-.177.08-.32.08zm10.256.215c-.415 0-.83-.048-1.229-.143-.399-.096-.71-.2-.918-.32-.128-.071-.215-.151-.247-.223a.563.563 0 0 1-.048-.224v-.407c0-.167.064-.247.183-.247.048 0 .096.008.144.024.048.016.12.048.2.08.271.12.566.215.878.279.319.064.63.096.95.096.502 0 .894-.088 1.165-.264a.86.86 0 0 0 .415-.758.777.777 0 0 0-.215-.559c-.144-.151-.416-.287-.807-.415l-1.157-.36c-.583-.183-1.014-.454-1.277-.813a1.902 1.902 0 0 1-.4-1.158c0-.335.073-.63.216-.886.144-.255.335-.479.575-.654.24-.184.51-.32.83-.415.32-.096.655-.136 1.006-.136.175 0 .359.008.535.032.183.024.35.056.518.088.16.04.312.08.455.127.144.048.256.096.336.144a.69.69 0 0 1 .24.2.43.43 0 0 1 .071.263v.375c0 .168-.064.256-.184.256a.83.83 0 0 1-.303-.096 3.652 3.652 0 0 0-1.532-.311c-.455 0-.815.071-1.062.223-.248.152-.375.383-.375.71 0 .224.08.416.24.567.159.152.454.304.877.44l1.134.358c.574.184.99.44 1.237.767.247.327.367.702.367 1.117 0 .343-.072.655-.207.926-.144.272-.336.511-.583.703-.248.2-.543.343-.886.447-.36.111-.734.167-1.142.167z"/><path fill="#ff9900" d="M21.698 16.207c-2.626 1.94-6.442 2.969-9.722 2.969-4.598 0-8.74-1.7-11.87-4.526-.247-.223-.024-.527.272-.351 3.384 1.963 7.559 3.153 11.877 3.153 2.914 0 6.114-.607 9.06-1.852.439-.2.814.287.383.607zM22.792 14.961c-.336-.43-2.22-.207-3.074-.103-.255.032-.295-.192-.063-.36 1.5-1.053 3.967-.75 4.254-.399.287.36-.08 2.826-1.485 4.007-.215.184-.423.088-.327-.151.32-.79 1.03-2.57.695-2.994z"/>' },
};
---
<Base title={`About: ${COMPANY}`} description={`${COMPANY} is founder-led. Meet Alexander Radovic, the founder and AI engineer who takes your first call and designs and builds your automation.`}>
  <section class="band top">
    <div class="wrap">
      <p class="eyebrow dot">About</p>
      <h1>Who you will be in the room with.</h1>
      <p class="lede">{COMPANY} is founder-led. The engineers on your first call are the ones who design and build your automation.</p>
    </div>
  </section>
  <section class="sec">
    <div class="wrap founder">
      <Picture src={FOUNDER.photo} formats={['avif', 'webp']} widths={[440, 880]} sizes="(max-width: 900px) min(440px, calc(100vw - 40px)), 460px" alt={`${FOUNDER.name}, founder of ${COMPANY}`} priority />
      <div class="bio">
        <p class="role">{FOUNDER.role}</p>
        <h2>{FOUNDER.name}</h2>
        <p>A whole working life in technology, and today an AI engineer. {FOUNDER.name.split(' ')[0]} talked to hundreds of recruiters during his career and saw the issues they faced from a different perspective. That’s why he brought together the best AI engineers and founded {COMPANY}: to bring much-needed, modernised automations to staffing and recruiting firms, reducing admin, improving talent acquisition and increasing profit margins.</p>
        <p>Every build starts from how your desk actually works and ends with a customised solution to your exact problem and a clear ROI.</p>
        <div class="certs">
          <p class="caps">AI certifications</p>
          <ul>
            {FOUNDER.certs.map((c) => (
              <li class="card" tabindex="0" title={`${c.name} (${c.code})`}>
                <div class="head">
                  <svg class="logo" viewBox={LOGOS[c.issuer].box} role="img" aria-label={LOGOS[c.issuer].label} set:html={LOGOS[c.issuer].svg} />
                  <span class="code">{c.code}</span>
                </div>
                <b aria-hidden="true">{c.short}</b>
                <span class="sr">{c.name}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="reach">
          {FOUNDER.linkedin && (
            <a class="li" href={FOUNDER.linkedin} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" /></svg>
              <span class="u">Connect on LinkedIn</span>
            </a>
          )}
          <a class="li mail" href={`mailto:${EMAIL}`}>
            <svg viewBox="2 2 20 20" aria-hidden="true"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z" /></svg>
            <span class="u">{EMAIL}</span>
          </a>
        </div>
      </div>
    </div>
  </section>
  <BookingBand />
</Base>

<style>
  .top{padding-block:96px 88px}
  .top .wrap{container-type:inline-size;display:grid;gap:22px;justify-items:start}
  h1{color:#fff;max-width:900px;font-size:clamp(34px,8cqi,60px);line-height:1.05;letter-spacing:-.035em}
  .founder{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:64px;align-items:center}
  img{width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;border-radius:24px;background:var(--tint)}
  .bio{display:grid;gap:18px;justify-items:start}
  .role{margin-bottom:-8px;font-weight:700;color:var(--act)}
  .li{margin-top:6px;display:inline-flex;align-items:center;gap:10px;font-size:14px;font-weight:700;color:var(--ink)}
  .li svg{width:20px;height:20px;fill:#0a66c2;flex:none}
  .reach{display:flex;flex-wrap:wrap;gap:6px 28px}
  /* the envelope is drawn 20 wide by 16 tall inside the 24 grid; the tighter viewBox renders it as wide as the LinkedIn mark */
  .mail svg{fill:var(--ink)}
  /* the label draws the nav links' accent underline on hover */
  .li .u{position:relative}
  .li .u::after{content:"";position:absolute;left:0;right:0;bottom:-4px;height:2px;background:var(--ac);transform:scaleX(0);transform-origin:left;transition:transform .4s cubic-bezier(.2,.7,.2,1);will-change:transform}
  @media (hover:hover){.li:hover .u::after{transform:scaleX(1)}}
  .bio > p:not(.eyebrow):not(.role){max-width:620px;font-size:17px}
  .certs{display:grid;gap:12px;width:100%;margin-top:10px}
  .certs ul{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
  .certs .card{padding:18px;gap:12px;transition:border-color .3s}
  .certs .head{display:flex;align-items:center;justify-content:space-between;gap:8px}
  .certs .logo{width:auto;height:24px;flex:none}
  .certs .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  .certs b{color:var(--ink);font-size:15px;line-height:1.3;overflow-wrap:anywhere}
  /* the cert code fades in on hover or keyboard focus, and stays shown on touch screens */
  .certs .code{font-size:13px;font-weight:700;letter-spacing:.04em;color:var(--act);opacity:0;transition:opacity .3s,translate .3s cubic-bezier(.2,.7,.2,1)}
  .certs .card:focus-visible .code{opacity:1;translate:0 0}
  @media (prefers-reduced-motion:no-preference){.certs .code{translate:0 4px}}
  @media (hover:hover){
    .certs .card:hover{border-color:var(--ac)}
    .certs .card:hover .code{opacity:1;translate:0 0}
  }
  @media (hover:none){.certs .code{opacity:1;translate:0 0}}
  @media (max-width:900px){
    .top{padding-block:72px 64px}
    .founder{grid-template-columns:minmax(0,1fr);gap:40px}
    img{max-width:440px}
  }
  @media (max-width:560px){.certs ul{grid-template-columns:minmax(0,1fr)}}
</style>
