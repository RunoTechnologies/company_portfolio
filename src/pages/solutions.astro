---
import Base from '../layouts/Base.astro';
import NotYet from '../components/NotYet.astro';
import BookingBand from '../components/BookingBand.astro';
import { COMPANY } from '../config';
---
<Base title={`Solutions: ${COMPANY}`}>
  <NotYet
    label="Solutions"
    title="Six places a staffing firm leaks hours and margin."
