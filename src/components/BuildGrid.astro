---
import { SOLUTIONS } from '../config';

const DETAIL: Record<string, { icon: string; text: string }> = {
  sourcing: { icon: 'search', text: 'Candidates sourced below Indeed and LinkedIn cost, from niche pools and your own re-engaged database.' },
  'show-up': { icon: 'accept', text: 'Enrichment, a warm-up sequence and automated replies that turn offers into accepted shifts.' },
  screening: { icon: 'shield', text: 'Identity, work-history and duplicate checks before a recruiter spends a minute on a profile.' },
  clients: { icon: 'pipe', text: 'Automated outreach and enrichment that opens the week with qualified client conversations.' },
  'back-office': { icon: 'sheet', text: 'Timesheets, invoicing and compliance that run without a coordinator chasing them.' },
  crm: { icon: 'crm', text: 'A CRM shaped to your desk when the one you have is the problem.' },
};
---
<section class="sec band build" id="solutions">
  <div class="wrap">
    <div class="head">
      <h2><svg class="ic"><use href="#i-layers" /></svg>What we build</h2>
      <p class="note">Tailored to your desk</p>
    </div>
    <div class="grid">
      {SOLUTIONS.map((s, i) => {
        const d = DETAIL[s.id];
        return (
          <div class="card" id={s.id}>
            <svg class="ic"><use href={`#i-${d.icon}`} /></svg>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.label}</h3>
            <p>{d.text}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .wrap{display:grid;gap:36px}
  h2{display:inline-flex;align-items:center;gap:14px}
  h2 .ic{width:28px;height:28px}
  h3{font-size:22px}
  /* An accent glow follows the pointer (the script sets --x and --y); isolation keeps it
     above the card's own background and below its content. */
  .card{isolation:isolate}
  .card::before{content:"";position:absolute;inset:0;z-index:-1;border-radius:inherit;pointer-events:none;background:radial-gradient(circle 180px at var(--x,50%) var(--y,50%),rgba(17,179,200,.22),transparent 70%);opacity:0;transition:opacity .3s ease}
  .card .ic,.card h3{transition:translate .3s cubic-bezier(.2,.7,.2,1)}
  @media (hover:hover){
    .card:hover::before{opacity:1}
  }
  @media (hover:hover) and (prefers-reduced-motion:no-preference){
    .card:hover .ic,.card:hover h3{translate:0 -3px}
  }
</style>

<script>
  for (const card of document.querySelectorAll<HTMLElement>('.build .card')) {
    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--x', `${e.clientX - r.left}px`);
      card.style.setProperty('--y', `${e.clientY - r.top}px`);
    }, { passive: true });
  }
</script>
