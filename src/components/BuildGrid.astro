---
import { SOLUTIONS } from '../config';

const ICON: Record<string, string> = { sourcing: 'search', 'show-up': 'accept', screening: 'shield', clients: 'pipe', 'back-office': 'sheet', crm: 'crm' };
---
<section class="sec band build" id="solutions">
  <div class="wrap">
    <div class="head">
      <div class="col">
        <h2><svg class="ic"><use href="#i-layers" /></svg>What we build</h2>
      </div>
    </div>
    <div class="grid">
      {SOLUTIONS.map((s, i) => {
        return (
          <div class="card" id={s.id}>
            <svg class="ic"><use href={`#i-${ICON[s.id]}`} /></svg>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.label}</h3>
            <p>{s.text}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .wrap{display:grid;gap:36px}
  h2{display:inline-flex;align-items:center;gap:14px}
  h2 .ic{width:28px;height:28px}
  h3{font-size:22px}
  .card .ic,.card h3{transition:translate .3s cubic-bezier(.2,.7,.2,1)}
  @media (hover:hover){
    .card:hover{border-color:var(--ac)}
  }
  @media (hover:hover) and (prefers-reduced-motion:no-preference){
    .card:hover .ic,.card:hover h3{translate:0 -3px}
  }
</style>
