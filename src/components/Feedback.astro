---
import Logo from './Logo.astro';
import { CASE_STUDIES } from '../config';

// Only the clients' names and marks are in the HTML. The quotes themselves come from
// /data/proof.json after load, a path robots.txt disallows, so the page is indexed without
// them; data-nosnippet keeps whatever a renderer still sees out of search snippets.
const WHO = CASE_STUDIES.map((c) => c.client);
---
<section class="sec band quo" data-nosnippet>
  <noscript><style>.quo{display:none}</style></noscript>
  <div class="wrap">
    <div class="head">
      <div class="col">
        <h2><svg class="ic"><use href="#i-quote" /></svg>From owners and ops leads</h2>
      </div>
    </div>
    <div class="view">
      <div class="track">
        {WHO.map((who) => (
          <figure class="qcard" data-who={who}>
            <blockquote><q></q></blockquote>
            <figcaption class="who"><Logo name={who} />{who}</figcaption>
          </figure>
        ))}
      </div>
    </div>
    <div class="dots">
      {WHO.map((_, i) => <button type="button" class:list={{ on: i === 0 }} aria-label={`Show quote ${i + 1}`}></button>)}
    </div>
  </div>
</section>

<style>
  .wrap{display:grid;gap:40px}
  h2{display:inline-flex;align-items:center;gap:14px}
  h2 .ic{width:28px;height:28px}
  .view{overflow:hidden}
  .track{display:flex;gap:20px;transition:transform .7s cubic-bezier(.4,0,.2,1)}
  .qcard{flex:0 0 calc((100% - 60px)/4);min-width:0;background:#fff;border:1px solid #fff;border-radius:14px;padding:22px 22px;display:grid;gap:16px;align-content:space-between}
  /* five lines of quote at the narrowest card, so the cards keep their height while the quotes load */
  blockquote{margin:0;min-height:116px}
  q{quotes:"\201C" "\201D";font-size:16px;line-height:1.45;font-weight:700;color:var(--ink);letter-spacing:-.02em}
  q:empty{quotes:none}
  .who{font-size:12px;letter-spacing:.1em;text-transform:uppercase;font-weight:700;color:var(--muted)}
  /* the client's mark takes the byline rule's place in the same 24px box and line height, so names wrap and cards size as before */
  .who :global(.logo){display:inline-block;vertical-align:middle;width:24px;aspect-ratio:auto;margin-right:12px;color:var(--ink);transition:color .3s ease}
  /* the track clips anything that moves out of the card, so the quote marks and the client's mark carry the hover */
  .qcard{transition:border-color .3s ease}
  q::before,q::after{transition:color .3s ease}
  @media (hover:hover){
    .qcard:hover{border-color:var(--ac)}
    .qcard:hover q::before,.qcard:hover q::after,.qcard:hover .who :global(.logo){color:var(--ac)}
  }
  .dots{display:flex;gap:8px;justify-content:center}
  .dots button{width:8px;height:8px;padding:0;border:0;border-radius:50%;background:var(--rail);cursor:pointer}
  .dots button.on{background:var(--ac)}
  @media (max-width:1100px){.qcard{flex-basis:calc((100% - 40px)/3)}}
  @media (max-width:800px){.qcard{flex-basis:calc((100% - 20px)/2)}}
  @media (max-width:560px){.qcard{flex-basis:100%}}
</style>

<script>
  import { reduce } from '../scripts/motion.js';
  const sec = document.querySelector<HTMLElement>('.quo');
  const view = document.querySelector<HTMLElement>('.quo .view');
  const track = document.querySelector<HTMLElement>('.quo .track');
  if (sec && view && track) {
    const cards = [...track.children] as HTMLElement[];
    // Fill the quotes in by client name; without them the section has nothing to say, so it goes.
    fetch('/data/proof.json')
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((d: { quotes: { who: string; q: string }[] }) => {
        for (const c of cards) {
          const q = d.quotes.find((x) => x.who === c.dataset.who)?.q;
          const el = c.querySelector('q');
          if (q && el) el.textContent = q;
        }
      })
      .catch(() => { sec.hidden = true; });
    const dots = [...document.querySelectorAll<HTMLButtonElement>('.quo .dots button')];
    let idx = 0;
    let hold = false;
    const stepW = () => cards[0].offsetWidth + 20;
    const visible = () => Math.max(1, Math.round(view.clientWidth / stepW()));
    const maxIdx = () => cards.length - visible();
    const render = () => {
      const m = maxIdx();
      if (idx > m) idx = 0;
      track.style.transform = `translateX(${-idx * stepW()}px)`;
      dots.forEach((d, i) => { d.hidden = i > m; d.classList.toggle('on', i === idx); });
    };
    render();
    // Recompute the step only: phones fire resize when the address bar moves, which must not rewind.
    addEventListener('resize', render);
    dots.forEach((d, i) => d.addEventListener('click', () => { idx = i; render(); }));
    for (const e of ['mouseenter', 'touchstart', 'focusin']) view.addEventListener(e, () => { hold = true; }, { passive: true });
    for (const e of ['mouseleave', 'touchend', 'focusout']) view.addEventListener(e, () => { hold = false; }, { passive: true });
    // Each slide commits a frame on the main thread for its whole transition, which hitches the
    // other sections' animations, so the carousel only advances while it is on screen.
    let away = false;
    if ('IntersectionObserver' in window) new IntersectionObserver(([e]) => { away = !e.isIntersecting; }).observe(view);
    if (!reduce) setInterval(() => { if (hold || away) return; idx = idx >= maxIdx() ? 0 : idx + 1; render(); }, 5000);
  }
</script>
