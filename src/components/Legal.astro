---
// Frame for the privacy and terms pages: the dark page header, then the sections in one reading column.
import { LEGAL } from '../config';
interface Props { label: string; title: string; lede: string }
const { label, title, lede } = Astro.props;
---
<section class="band top">
  <div class="wrap">
    <p class="eyebrow dot">{label}</p>
    <h1>{title}</h1>
    <p class="lede">{lede}</p>
    <p class="updated">Last updated {LEGAL.updated}</p>
  </div>
</section>
<section class="sec">
  <div class="wrap">
    <div class="legal">
      <slot />
    </div>
  </div>
</section>

<style>
  .top{padding-block:88px 72px}
  h1{color:#fff;max-width:900px;font-size:clamp(34px,5vw,56px);line-height:1.04}
  .lede{max-width:640px;margin-top:20px;font-size:18px}
  .updated{margin-top:18px;font-size:14px;color:var(--dim)}
  .legal{max-width:720px}
  .legal :global(h2){font-size:24px;line-height:1.2;margin-top:44px}
  .legal :global(h2:first-child){margin-top:0}
  .legal :global(p){margin-top:12px;font-size:17px}
  .legal :global(ul){margin-top:12px;padding-left:22px;list-style:disc}
  .legal :global(li){margin-top:8px;font-size:17px}
  .legal :global(a){color:var(--act);font-weight:700}
  @media (max-width:560px){
    .top{padding-block:60px 48px}
    .legal :global(h2){margin-top:36px}
  }
</style>
