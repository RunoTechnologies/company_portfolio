---
import { CAL_URL } from '../config';
---
<section class="wrap tail">
  <div class="dark">
    <div class="copy">
      <h2>Thirty minutes on where your pipeline loses candidates and hours. <span class="ac">Book a free consultation.</span></h2>
      <small>Free · 30 min · you leave with a written list either way</small>
    </div>
    <a class="btn light" href={CAL_URL}><span class="lbl">Open the calendar</span><span class="chip"><svg class="arr"><use href="#i-arrow" /></svg></span></a>
  </div>
</section>

<style>
  .dark{background:var(--ink);color:#fff;border-radius:24px;padding:48px 52px;display:flex;align-items:center;justify-content:space-between;gap:32px;flex-wrap:wrap;position:relative;overflow:hidden}
  .dark::before{content:"";position:absolute;right:-120px;top:-160px;width:420px;height:420px;background:radial-gradient(circle,rgba(17,179,200,.35),rgba(17,179,200,0) 65%)}
  .copy{display:grid;gap:14px;max-width:620px;position:relative}
  h2{color:#fff;font-size:clamp(26px,3vw,36px)}
  h2 .ac{color:var(--ac)}
  small{font-size:13px;color:var(--dim)}
  .btn{position:relative}
  @media (max-width:900px){.dark{padding:40px 32px}}
  /* the label wraps rather than overflowing the card on a narrow phone */
  @media (max-width:560px){h2{font-size:26px}.btn{white-space:normal}}
</style>
