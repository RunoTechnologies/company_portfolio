---
const WAYS = [
  { icon: 'audit', title: 'Audit only', text: 'A week on your data and a written list. Take it to anyone.' },
  { icon: 'layers', title: 'Build and hand over', text: 'We build the automations, run them beside your team for a month, then hand over.' },
  { icon: 'loop', title: 'Build and run', text: 'We keep running and tuning the pipeline on a monthly basis.' },
];
---
<section class="sec eng" id="engage">
  <div class="wrap">
    <div class="head">
      <h2>How we work with you</h2>
      <p class="note">Three ways in, one method</p>
    </div>
    <div class="grid">
      {WAYS.map((w, i) => (
        <div class="card">
          <svg class="ic"><use href={`#i-${w.icon}`} /></svg>
          <span class="n">{String(i + 1).padStart(2, '0')}</span>
          <h3>{w.title}</h3>
          <p>{w.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .wrap{display:grid;gap:36px}
  h3{font-size:22px}
</style>
