---
// Stand-in for a page the design specifies but the build has not reached.
interface Props { label: string; title: string; lede: string }
const { label, title, lede } = Astro.props;
---
<section class="sec notyet">
  <div class="wrap">
    <p class="eyebrow dot">{label} · Not built yet</p>
    <h1>{title}</h1>
    <p class="lede">{lede}</p>
    <a class="tlink" href="/">Back to the home page <svg class="arr"><use href="#i-arrow" /></svg></a>
  </div>
</section>
