---
import { CASE_STUDIES } from '../config';

// Starting values for the calculator: inputs a visitor overwrites, not claims about anyone's desk.
const INPUTS = [
  { id: 'ns', label: 'No-shows a week', value: 4, step: 1 },
  { id: 'mg', label: 'Margin per shift ($)', value: 45, step: 5 },
  { id: 'hr', label: 'Admin hours a week, whole team', value: 30, step: 1 },
  { id: 'rt', label: 'Cost per hour ($)', value: 25, step: 1 },
];
const v = Object.fromEntries(INPUTS.map((f) => [f.id, f.value]));
const start = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 0, maximumFractionDigits: 0 })
  .format(52 * (v.ns * v.mg + v.hr * v.rt));
---
<section class="sec res" id="results">
  <div class="wrap">
    <div class="head">
      <div class="col">
        <h2>Where your desk loses money. <span class="ac">And what we change.</span></h2>
      </div>
    </div>
    <div class="grid">
      {CASE_STUDIES.map((c) => (
        <a class="card ink case" href={`/case-studies/${c.slug}`}>
          <div class="pain">
            <p class="scene">{c.scene}</p>
            <p class="stakes"><b>If nothing changes:</b> {c.stakes}</p>
          </div>
          <div class="fix">
            <p><b>Automated:</b> {c.fix}</p>
            <div class="foot">
              <span class="view"><span class="lbl">View case study</span> <svg class="arr"><use href="#i-arrow" /></svg></span>
            </div>
          </div>
        </a>
      ))}
    </div>
    <form class="calc" aria-labelledby="calc-h">
      <div class="calc-head">
        <h3 id="calc-h">What this week costs you in a year</h3>
        <p class="note">Put in your numbers.</p>
      </div>
      <div class="fields">
        {INPUTS.map((f) => (
          <label>
            <span>{f.label}</span>
            <input id={`calc-${f.id}`} type="number" inputmode="decimal" min="0" step={f.step} value={f.value} />
          </label>
        ))}
      </div>
      <p class="total" aria-live="polite">
        <b id="calc-out">{start}</b>
        <span>a year in lost shift margin and admin time</span>
      </p>
    </form>
  </div>
</section>

<style>
  .wrap{display:grid;gap:40px}
  h2 .ac{color:var(--act)}
  .case{padding:0;gap:0;grid-template-rows:1fr auto;overflow:hidden;transition:border-color .3s ease}
  .pain{padding:26px 28px 22px;display:grid;gap:10px;align-content:start}
  .case .scene{font-size:17px;line-height:1.45;font-weight:700;color:#fff;letter-spacing:-.01em}
  .case .stakes{font-size:14px}
  .stakes b{color:#fff}
  .fix{padding:20px 28px 24px;display:grid;gap:10px;background:rgba(17,179,200,.12);border-top:1px solid rgba(255,255,255,.12);transition:background-color .3s ease}
  .fix p{color:#fff}
  .foot{display:flex;justify-content:flex-end}
  .view{flex:none;display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#fff;white-space:nowrap}
  .view .arr{width:14px;height:14px}
  .case:focus-visible{outline:2px solid var(--ac);outline-offset:3px}
  /* Hovering the card draws the label's accent underline and runs the arrow through, as on the site's buttons. */
  .view .lbl{position:relative}
  .view .lbl::after{content:"";position:absolute;left:0;right:0;bottom:-4px;height:2px;background:var(--ac);transform:scaleX(0);transform-origin:left;transition:transform .4s cubic-bezier(.2,.7,.2,1)}
  .case:focus-visible .lbl::after{transform:scaleX(1)}
  @media (hover:hover){
    .case:hover .lbl::after{transform:scaleX(1)}
    .case:hover .view .arr{animation:arr-fade-through .5s cubic-bezier(.5,0,.2,1)}
    .case:hover{border-color:var(--ac)}
    .case:hover .fix{background:rgba(17,179,200,.22)}
  }

  .calc{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr) auto;gap:28px;align-items:end;padding:28px;background:var(--card);border:1px solid var(--line);border-radius:16px}
  .calc-head{display:grid;gap:6px}
  .fields{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
  .fields label{display:grid;gap:6px;font-size:13px;color:var(--muted);align-content:end}
  .fields input{width:100%;box-sizing:border-box;padding:10px 12px;border-radius:10px;border:1px solid var(--line);background:#fff;color:var(--ink);font:inherit;font-size:16px;font-variant-numeric:tabular-nums}
  .fields input:focus-visible{outline:2px solid var(--ac);outline-offset:1px}
  .total{display:grid;gap:4px;min-width:200px}
  .total b{font-size:40px;line-height:1;font-weight:800;letter-spacing:-.03em;color:var(--act);font-variant-numeric:tabular-nums}
  .total span{font-size:13px;color:var(--muted)}
  @media (max-width:1000px){
    .calc{grid-template-columns:minmax(0,1fr)}
    .total{min-width:0}
  }
  @media (max-width:560px){
    .fields{grid-template-columns:repeat(2,minmax(0,1fr))}
    .pain{padding:22px 22px 18px}
    .fix{padding:18px 22px 20px}
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('.res .calc');
  if (form) {
    const val = (id: string) => Math.max(0, Number((form.querySelector(`#calc-${id}`) as HTMLInputElement).value) || 0);
    const out = form.querySelector('#calc-out')!;
    const usd = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 0, maximumFractionDigits: 0 });
    const update = () => {
      const total = 52 * (val('ns') * val('mg') + val('hr') * val('rt'));
      out.textContent = Number.isFinite(total) ? usd.format(total) : '—';
    };
    form.addEventListener('input', update);
    form.addEventListener('submit', (e) => e.preventDefault());
    update();
  }
</script>
