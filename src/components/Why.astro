---
// Admin chores ride three lanes through a scan line: left of it each is a chore, right of it the
// same task comes out done. Each chip has a copy in two half-width panes clipped at the line, so a
// task changes as it crosses. The chips move with CSS transforms, which the compositor runs off the
// main thread; SMIL repainted the whole figure on the main thread and hitched whenever other page
// scripts ran. Chips wait, then glide in one eased hop: slow constant drift showed every dropped
// or pixel-snapped frame as a judder. Lengths are in figure units (480 x 320) converted to cqi in
// the styles.
const LANES = [
  { y: 70, dur: 12, tasks: [['Chase timesheet', 'Timesheet approved'], ['Check right to work', 'RTW verified']] },
  { y: 160, dur: 14, tasks: [['Call to confirm shift', 'Shift confirmed'], ['Re-key candidate', 'Profile synced']] },
  { y: 250, dur: 13, tasks: [['Screen applicant', 'Applicant screened'], ['Build invoice', 'Invoice sent']] },
];
// A chip is 220 wide and makes three hops per cycle (the `ride` keyframes): in from x=-220 to a
// todo stop just left of the line, across to a done stop just right of it, then out to x=480.
// Each hop crosses a whole chip width, so no chip ever rests astride the line. Negative delays
// spread the tasks; --x is the same starting frame as a static offset, so under reduced motion
// every lane still shows its tasks. Lane partners sit half a cycle apart and never overlap.
const STOPS = [[0, -220], [0.2, -220], [1 / 3, 13.333], [0.5333, 13.333], [2 / 3, 246.667], [0.8667, 246.667], [1, 480]];
const at = (p) => {
  for (let k = 1; k < STOPS.length; k++) {
    const [a, x0] = STOPS[k - 1], [b, x1] = STOPS[k];
    if (p <= b) { const t = (p - a) / (b - a); return x0 + (x1 - x0) * t * t * (3 - 2 * t); }
  }
  return 480;
};
const chips = LANES.flatMap((l, i) => l.tasks.map(([todo, done], j) => {
  const p = (j / l.tasks.length + 0.27 + i * 0.04) % 1;
  return {
    todo, done,
    style: `top:${(l.y / 320) * 100}%;--t:${l.dur}s;--d:${(-p * l.dur).toFixed(2)}s;--x:${((at(p) / 220) * 100).toFixed(2)}%`,
  };
}));

const POINTS = [
  { icon: 'focus', title: 'Staffing is all we do', text: 'We only build for staffing and recruiting desks, so the first call starts from your vocabulary, not ours.' },
  { icon: 'loop', title: 'One method across the whole order', text: 'Sourcing, screening, confirmation, timesheets, invoicing: one pipeline, instrumented end to end.' },
  { icon: 'target', title: 'Outcome-driven by design', text: 'Every build names the number it moves before we start and reports it weekly after launch.' },
];
---
<section class="sec why">
  <div class="wrap">
    <div class="top">
      <div class="col">
        <p class="eyebrow dot">Why Runo Technologies</p>
        <h2>Everyone is hiring recruiters to do admin. <span class="ac">We automate the admin instead.</span></h2>
        <p>Most desks lose a day a week to chasing, checking and re-keying. We build the automation that does it, and we stay until the team trusts it.</p>
      </div>
      <div class="vis">
        <div class="stage" aria-hidden="true">
          {LANES.map((l) => <i class="lane" style={`top:${(l.y / 320) * 100}%`}></i>)}
          <div class="pane todo">
            {chips.map((c) => <span class="chip" style={c.style}><b class="tick"></b>{c.todo}</span>)}
          </div>
          <div class="pane done">
            {chips.map((c) => (
              <span class="chip" style={c.style}><b class="tick"><svg viewBox="-9 -9 18 18"><path d="M-4 0l3 3 5-6" /></svg></b>{c.done}</span>
            ))}
          </div>
          <i class="beam"></i>
          <i class="line"></i>
        </div>
      </div>
    </div>
    <div class="three">
      {POINTS.map((p, i) => (
        <div>
          <svg class="ic"><use href={`#i-${p.icon}`} /></svg>
          <span class="n">{String(i + 1).padStart(2, '0')}</span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .wrap{container-type:inline-size;display:grid;gap:64px}
  .top{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px;align-items:center}
  .col{display:grid;gap:22px}
  h2{font-size:clamp(32px,6vw,54px);font-size:clamp(32px,4.9cqi,54px);line-height:1.06}
  h2 .ac{color:var(--act)}
  .col p:last-child{font-size:17px;max-width:520px}
  .vis{position:relative;overflow:hidden;isolation:isolate}
  .vis::before{content:"";position:absolute;inset:-10%;background:radial-gradient(ellipse at center,var(--pale) 0%,rgba(255,255,255,0) 65%);pointer-events:none}
  /* one figure unit is 100cqi/480 */
  .stage{position:relative;aspect-ratio:3/2;container-type:inline-size}
  .lane{position:absolute;left:0;right:0;height:1px;background:repeating-linear-gradient(90deg,var(--rail) 0 2px,transparent 2px 8px)}
  .pane{position:absolute;top:0;bottom:0;width:50%;overflow:hidden}
  .todo{left:0}
  .done{left:50%}
  .done .chip{left:-100%}
  .chip{position:absolute;left:0;width:45.833cqi;height:9.167cqi;margin-top:-4.583cqi;padding-left:3.125cqi;display:flex;align-items:center;gap:1.875cqi;border-radius:999px;box-sizing:border-box;font-size:3.125cqi;font-weight:700;white-space:nowrap;transform:translateX(var(--x));animation:ride var(--t) cubic-bezier(.65,0,.35,1) var(--d) infinite;will-change:transform}
  .todo .chip{background:#fff;border:1px solid var(--rail);color:var(--muted)}
  .done .chip{background:var(--ink);color:#fff}
  .tick{flex:none;width:3.75cqi;height:3.75cqi;border-radius:50%;display:grid;place-items:center}
  .todo .tick{border:.3125cqi solid var(--dim);transform:scale(.89)}
  .done .tick{background:var(--ac)}
  .tick svg{width:100%;height:100%;fill:none;stroke:var(--ink);stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
  .beam{position:absolute;top:4.375%;bottom:4.375%;left:calc(50% - 4.167cqi);width:8.333cqi;background:linear-gradient(90deg,rgba(17,179,200,0),rgba(17,179,200,.22),rgba(17,179,200,0))}
  .line{position:absolute;top:4.375%;bottom:4.375%;left:calc(50% - .208cqi);width:.417cqi;border-radius:1cqi;background:var(--ac)}
  @keyframes ride{0%,20%{transform:translateX(-100%)}33.333%,53.333%{transform:translateX(6.061%)}66.667%,86.667%{transform:translateX(112.121%)}100%{transform:translateX(218.182%)}}
  .three{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--line)}
  .three>div{position:relative;padding:36px 32px 0;display:grid;gap:12px;align-content:start}
  .three>div+div{border-left:1px solid var(--line)}
  .three>div:first-child{padding-left:0}
  .three>div:last-child{padding-right:0}
  .n{top:36px;right:32px}
  .three>div:last-child .n{right:0}
  .three h3,.three p{max-width:300px}
  .three p{font-size:15px}
  @media (max-width:900px){
    .top,.three{grid-template-columns:minmax(0,1fr)}
    .three>div{padding:28px 0}
    .three>div+div{border-left:0;border-top:1px solid var(--line)}
    .n{right:0;top:28px}
  }
</style>
