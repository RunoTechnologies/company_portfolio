---
import { Image } from 'astro:assets';
import { CAL_URL, FOUNDER } from '../config';
---
<section class="hero">
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap">
    <p class="eyebrow">AI automation for staffing and recruiting firms</p>
    <h1><span class="sm">Stop chasing.</span> <span class="ac">Start placing.</span></h1>
    <p class="lede"><b>Lower cost per hire.</b> <b>Higher show-up rates.</b> <b>More candidates.</b> <b>Fewer admin hours.</b> Your recruiters should be talking to candidates and clients, not chasing them and doing admin work. We automate the rest.</p>
    <div class="cta">
      <a class="btn light" href={CAL_URL}><span class="lbl">Book a free consultation</span><span class="chip"><svg class="arr"><use href="#i-arrow" /></svg></span></a>
      <a class="tlink" href="/#process">How the process works <svg class="arr"><use href="#i-arrow" /></svg></a>
    </div>
    <p class="fine">30 minutes. We look at your pipeline and name the bottlenecks worth automating.</p>
    <a class="by" href="/about"><Image src={FOUNDER.avatar} alt={FOUNDER.name} width={40} densities={[1, 2]} /><span>Meet the founder</span><svg class="arr"><use href="#i-arrow" /></svg></a>
  </div>
</section>

<style>
  /* navy like the CTA band, so the page opens and closes on the same ground */
  /* grows to fill the first screen with the client strip (see .intro on the home page), content centred */
  .hero{position:relative;overflow:hidden;flex:1 0 auto;display:flex;flex-direction:column;justify-content:center;padding-block:120px 96px;text-align:center;background:var(--ink);color:#c5cdd9}
  .glow{position:absolute;left:50%;top:-220px;width:1200px;height:820px;transform:translateX(-50%);background:radial-gradient(ellipse at center,rgba(17,179,200,.3) 0%,rgba(17,179,200,.12) 35%,rgba(17,179,200,0) 70%);pointer-events:none}
  /* width:100% because the auto margins would otherwise shrink a flex item, and inline-size containment shrinks it to nothing */
  .wrap{position:relative;width:100%;container-type:inline-size;display:grid;justify-items:center;gap:36px}
  .eyebrow{color:var(--ac);font-size:14px;letter-spacing:.1em}
  h1{color:#fff;font-size:clamp(34px,7vw,92px);font-size:clamp(34px,13cqi,92px);line-height:1.02;letter-spacing:-.035em}
  h1 span{display:block}
  h1 .sm{font-size:.85em}
  h1 .ac{color:var(--ac)}
  .lede{letter-spacing:-.01em}
  .lede b{color:#fff}
  .tlink{position:relative;color:#fff}
  .tlink::after{content:"";position:absolute;left:0;right:0;bottom:-6px;height:2px;background:var(--ac);transform:scaleX(0);transform-origin:left;transition:transform .4s cubic-bezier(.2,.7,.2,1);will-change:transform}
  @media (hover:hover){
    .tlink:hover::after{transform:scaleX(1)}
  }
  .cta{display:flex;align-items:center;justify-content:center;gap:28px;flex-wrap:wrap}
  .fine{font-size:13px;color:var(--dim);margin-top:-12px}
  /* a quiet byline: a face on the call without competing with the CTA */
  .by{display:inline-flex;align-items:center;gap:12px;padding:5px 16px 5px 5px;border-radius:999px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);color:#fff;font-size:14px;font-weight:500;margin-top:-4px;transition:border-color .3s,background .3s}
  .by img{display:block;flex:none;width:40px;height:40px;border-radius:50%;object-fit:cover;box-shadow:0 0 0 2px var(--ac)}
  .by .arr{color:var(--ac);transition:transform .3s cubic-bezier(.2,.7,.2,1)}
  @media (hover:hover){
    .by:hover{border-color:var(--ac);background:rgba(17,179,200,.1)}
    .by:hover .arr{transform:translateX(3px)}
  }
  @media (max-width:900px){.hero{padding-block:72px 64px}}
  @media (max-width:560px){.hero{padding-block:72px 56px}}
</style>
