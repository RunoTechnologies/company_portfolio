---
import { CAL_URL, QUALIFY } from '../config';
---
<dialog class="qualify" data-cal={CAL_URL} aria-labelledby="q-title">
  <form>
    <button class="x" type="button" aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
    <div class="head">
      <h2 id="q-title">Two quick questions before the calendar</h2>
      <p>So the call is pitched at the size of your firm.</p>
    </div>
    {QUALIFY.map((q) => (
      <fieldset>
        <legend>{q.label}</legend>
        <div class="opts">
          {q.options.map((o) => (
            <label><input type="radio" name={q.key} value={o} required /><span>{o}</span></label>
          ))}
        </div>
      </fieldset>
    ))}
    <button class="btn" type="submit"><span class="lbl">Continue to the calendar</span><span class="chip"><svg class="arr"><use href="#i-arrow" /></svg></span></button>
  </form>
</dialog>

<style>
  .qualify{width:min(560px,calc(100% - 32px));max-height:calc(100% - 32px);padding:0;border:0;border-radius:24px;background:var(--bg);color:var(--body);box-shadow:0 24px 64px rgba(11,21,38,.28)}
  .qualify::backdrop{background:rgba(11,21,38,.6)}
  form{position:relative;display:grid;gap:24px;padding:40px}
  .head{display:grid;gap:8px;padding-right:32px}
  h2{font-size:26px}
  .head p{color:var(--muted);font-size:15px}
  .x{position:absolute;top:20px;right:20px;width:36px;height:36px;display:grid;place-items:center;border:0;border-radius:50%;background:var(--tint);color:var(--ink);cursor:pointer}
  .x svg{width:18px;height:18px}
  fieldset{margin:0;padding:0;border:0;min-width:0}
  legend{padding:0;margin-bottom:10px;color:var(--ink);font-weight:700;font-size:15px}
  .opts{display:flex;flex-wrap:wrap;gap:8px}
  label{position:relative;cursor:pointer}
  /* the radio stays in the tab order and the form's validation; the chip is what shows */
  input{position:absolute;inset:0;margin:0;opacity:0;cursor:pointer}
  label span{display:block;padding:9px 16px;border:1px solid var(--line);border-radius:999px;background:var(--card);color:var(--ink);font-weight:500;font-size:14px;transition:border-color .2s,background .2s}
  label:hover span{border-color:var(--rail)}
  input:checked + span{border-color:var(--act);background:var(--pale);font-weight:700}
  input:focus-visible + span{outline:2px solid var(--act);outline-offset:3px}
  .btn{justify-self:start;border:0;font-family:inherit;cursor:pointer}
  @media (max-width:560px){form{padding:32px 24px}h2{font-size:22px}.btn{white-space:normal}}
</style>

<script>
  // Every link to the calendar opens this first; without JS the links still go straight to Cal.com.
  const dialog = document.querySelector<HTMLDialogElement>('.qualify')!;
  const form = dialog.querySelector('form')!;
  const cal = dialog.dataset.cal!;

  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest('a');
    if (!a || a.getAttribute('href') !== cal) return;
    if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    e.preventDefault();
    dialog.showModal();
  });

  dialog.querySelector('.x')!.addEventListener('click', () => dialog.close());
  // a click on the backdrop lands on the dialog element itself; so does a drag that starts inside the form and ends outside
  let downOnBackdrop = false;
  dialog.addEventListener('pointerdown', (e) => { downOnBackdrop = e.target === dialog; });
  dialog.addEventListener('click', (e) => { if (e.target === dialog && downOnBackdrop) dialog.close(); });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const url = new URL(cal);
    for (const [key, value] of new FormData(form)) {
      url.searchParams.set(key, String(value));
      url.searchParams.set(`metadata[${key}]`, String(value));
    }
    // closed first, or Back restores the page from the bfcache with the modal still open
    dialog.close();
    location.assign(url);
  });
</script>
