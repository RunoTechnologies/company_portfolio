---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import Qualify from '../components/Qualify.astro';
import Sprite from '../components/Sprite.astro';
import { CAL_URL, COMPANY, DESCRIPTION, NAV, SOLUTIONS } from '../config';

interface Props { title: string; description?: string; type?: 'website' | 'article'; noindex?: boolean }
const { title, description = DESCRIPTION, type = 'website', noindex = false } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/'; // the public URL: build.format 'file' names pages /about.html
const canonical = new URL(path, Astro.site).href;
const card = new URL('/og.png', Astro.site).href; // scripts/og-card.mjs draws it
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light only">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex">}
  <meta property="og:type" content={type}>
  <meta property="og:site_name" content={COMPANY}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={card}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={`${COMPANY}: Stop chasing. Start placing.`}>
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <Font cssVariable="--font-sans" preload />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <Sprite />

  <header class="nav">
    <div class="wrap nav-in">
      <a class="brand" href="/" aria-label={`${COMPANY}, home`}><Mark /><span>{COMPANY}</span></a>
      <nav class="links" aria-label="Primary">
        {NAV.map((n) => (
          <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
      <div class="nav-r">
        <a class="pill" href={CAL_URL}>Book a consult <svg class="arr"><use href="#i-arrow" /></svg></a>
        <details class="menu">
          <summary aria-label="Open menu">Menu<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg></summary>
          <div class="sheet">
            {NAV.map((n) => <a href={n.href}>{n.label}</a>)}
          </div>
        </details>
      </div>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer>
    <div class="wrap">
      <div class="fgrid">
        <div>
          <span class="brand"><Mark />{COMPANY}</span>
          <p>{DESCRIPTION}</p>
        </div>
        <div>
          <p class="fh">Pages</p>
          <ul>{NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
        </div>
        <div>
          <p class="fh">Solutions</p>
          <ul>{SOLUTIONS.map((s) => <li><a href={`/#${s.id}`}>{s.label}</a></li>)}</ul>
        </div>
      </div>
      <p class="fbot">© {year} {COMPANY} · <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></p>
    </div>
  </footer>

  <Qualify />

  <script>
    // A same-page link in the mobile menu would otherwise leave the sheet open over the content.
    const menu = document.querySelector<HTMLDetailsElement>('.menu');
    menu?.addEventListener('click', (e) => {
      if ((e.target as Element).closest('.sheet a')) menu.open = false;
    });
  </script>
</body>
</html>
