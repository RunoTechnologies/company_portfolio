{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "runotech-website",
  "compatibility_date": "2026-10-01",
  // Static assets only; _redirects and _headers in public/ are applied by Cloudflare, not served.
  "assets": { "directory": "./dist" },
  "routes": [{ "pattern": "runotech.com", "custom_domain": true }],
  // The site lives on runotech.com only; branch builds still get preview URLs.
  "workers_dev": false,
  "preview_urls": true,
  // Branch builds run `wrangler preview`, which refuses to start without this block; it may stay empty.
  "previews": {}
}
